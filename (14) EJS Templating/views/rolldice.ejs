<!-- Roll the Dice -->

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Roll the Dice</title>
    </head>
    <body>
        <h1>Roll the Dice</h1>
        <p>You rolled a <%= diceRoll %>!</p> <!-- Passing data to EJS template -->
        <!-- Conditional statement rendering -->
        <% if (Number(diceRoll) === 6) { %>
        <p>Nice! You rolled a 6! <i>Now roll again!</i></p>
        <% } %>
    </body>
</html>