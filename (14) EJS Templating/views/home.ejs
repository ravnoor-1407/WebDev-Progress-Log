<!-- EJS Home Page Template -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
</head>
<body>
    <h1>Welcome to the Home Page</h1>
    <h3>1  + 2 = <%= 1 + 2 %></h3>  <!-- EJS Interpolation that embeds the expressions into the markup. -->
    <p>This is a simple EJS template.</p>
    <p>This documentation explains how to use EJS templates in Express.js.</p>
    <button>Click me</button>
</body>
</html>